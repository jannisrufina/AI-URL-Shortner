POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432

DATABASE_URL=postgresql://url_shortener:replace-with-a-local-password@localhost:5432/url_shortener
PUBLIC_BASE_URL=https://jrb.sh
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_WAIT_MS=250
DB_CONNECT_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=1000
TEST_DATABASE_URL=postgresql://url_shortener:replace-with-a-local-password@localhost:5432/url_shortener_test
